#!/usr/bin/make -f
%:
	dh $@ --buildsystem=cmake

LB_DEFAULT_SERVER_URL ?=

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=RelWithDebInfo -DLB_DEFAULT_SERVER_URL="$(LB_DEFAULT_SERVER_URL)"

# Skip ctest during package build: tests need fixtures/server not available here.
override_dh_auto_test: